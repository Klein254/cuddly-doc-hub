{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vector Doc Hub",
  "version": "1.0.0",
  "identifier": "com.vectortechnical.dochub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vector Doc Hub",
        "width": 1320,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#07080a",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "publisher": "Vector Technical",
    "copyright": "© Vector Technical Maintenance & General Supplies",
    "category": "Business",
    "shortDescription": "Quotations, invoices, delivery notes and statements",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
