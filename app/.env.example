# Cloud sync. Fill in ONE of the two blocks (Firebase is used if both are set).
# Leave everything blank to run in local-only mode (documents stay on that device).
# See FIREBASE.md for step-by-step setup.

# Firebase: console → Project settings → General → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Supabase (alternative): Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
